# Frontend (Next.js) environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# NextAuth — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=your-auth-secret
AUTH_URL=http://localhost:3000/auth_endpoints
AUTH_TRUST_HOST=true

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# The only email address allowed to sign in
ALLOWED_USER_EMAIL=you@example.com

# MongoDB Atlas connection string — used by the /api/heatmap/relative-strength route
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"

# Feature flag for the Prompt Injection Lab (/injection-lab) — optional, defaults to
# enabled if unset. Set to "false" to hide its sidebar link and page. Must match
# ENABLE_INJECTION_LAB in api/.env — flipping only one side hides the UI but leaves
# the backend endpoint reachable, or vice versa.
NEXT_PUBLIC_ENABLE_INJECTION_LAB=true
