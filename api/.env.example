# Backend (FastAPI) environment variables.
# Copy to api/.env and fill in real values. Never commit api/.env.

# Google Gemini API key — required for all /api/ai/* analysis endpoints
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# MongoDB Atlas connection string (database: ai_stock_analyst)
# Used by watchlist, rankings, trackers, govt contracts
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"

# SEC EDGAR requires a User-Agent with a contact email
# Format: "AppName your-email@example.com"
SEC_USER_AGENT="AIAnalyst your-email@example.com"

# Financial Modeling Prep — Congress / House / Senate trades
FMP_API_KEY=your-fmp-api-key

# YouTube Data API v3 — brand sentiment (optional; YouTube is skipped if unset)
YOUTUBE_API_KEY=your-youtube-api-key

# Anthropic API key — powers the Stock Analyst Assistant chat widget (optional;
# the rest of the app works without it). https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pinecone API key — semantic search over SEC filings (RAG), used by the
# Stock Analyst Assistant's search_filings tool (optional). https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key

# FRED (Federal Reserve Economic Data) API key — live GDP/unemployment/CPI/Fed
# rate on /macro (optional; a hardcoded 2024 snapshot is used if unset).
# Free, instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# Must be the SAME value as AUTH_SECRET in the frontend's .env.local.
# The backend uses it to verify that API requests come from a signed-in user.
AUTH_SECRET=your-auth-secret

# The only email address allowed to sign in (same as in .env.local)
ALLOWED_USER_EMAIL=you@example.com
