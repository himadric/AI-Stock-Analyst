{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/merge_gate.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
